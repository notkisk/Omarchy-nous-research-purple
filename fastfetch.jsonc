{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/omarchy/current/theme/fastfetch-logo.txt",
    "padding": { "top": 0, "right": 4, "left": 0 }
  },
  "display": {
    "separator": "  ",
    "color": "#cdd6f4",
    "brightColor": false
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;203;166;247m  ╭─ NOUS RESEARCH / FIELD NOTE ───────────────╮" },
    { "type": "os", "key": "  │ os", "keyColor": "#cba6f7" },
    { "type": "host", "key": "  │ host", "keyColor": "#cba6f7" },
    { "type": "kernel", "key": "  │ kernel", "keyColor": "#cba6f7" },
    { "type": "uptime", "key": "  │ uptime", "keyColor": "#cba6f7" },
    { "type": "cpu", "key": "  │ cpu", "keyColor": "#89b4fa", "showPeCoreCount": true },
    { "type": "gpu", "key": "  │ gpu", "keyColor": "#89b4fa", "detectionMethod": "pci" },
    { "type": "memory", "key": "  │ memory", "keyColor": "#89b4fa" },
    { "type": "disk", "key": "  ╰─ disk", "keyColor": "#89b4fa", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;69;71;90m  ├─────────────────────────────────────────────┤" },
    { "type": "wm", "key": "  │ wm", "keyColor": "#cba6f7" },
    { "type": "de", "key": "  │ de", "keyColor": "#cba6f7" },
    { "type": "terminal", "key": "  │ terminal", "keyColor": "#cba6f7" },
    { "type": "packages", "key": "  ╰─ packages", "keyColor": "#cba6f7" },
    { "type": "custom", "format": "\u001b[38;2;148;226;213m  ◇ research · build · understand · nous\u001b[0m" }
  ]
}

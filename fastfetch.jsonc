{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.local/state/omarchy/current/theme/fastfetch-logo.txt",
    "color": { "1": "#a746e8" },
    "padding": { "top": 0, "right": 4, "left": 0 }
  },
  "display": {
    "separator": "  ",
    "color": "#ded7e8",
    "brightColor": false
  },
  "modules": [
    { "type": "custom", "format": "\u001b[38;2;167;70;232m  ╭─ NOUS RESEARCH / FIELD NOTE ───────────────╮" },
    { "type": "os", "key": "  │ os", "keyColor": "#a746e8" },
    { "type": "host", "key": "  │ host", "keyColor": "#a746e8" },
    { "type": "kernel", "key": "  │ kernel", "keyColor": "#a746e8" },
    { "type": "uptime", "key": "  │ uptime", "keyColor": "#a746e8" },
    { "type": "cpu", "key": "  │ cpu", "keyColor": "#9563da", "showPeCoreCount": true },
    { "type": "gpu", "key": "  │ gpu", "keyColor": "#9563da", "detectionMethod": "pci" },
    { "type": "memory", "key": "  │ memory", "keyColor": "#9563da" },
    { "type": "disk", "key": "  ╰─ disk", "keyColor": "#9563da", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;52;35;70m  ├─────────────────────────────────────────────┤" },
    { "type": "wm", "key": "  │ wm", "keyColor": "#a746e8" },
    { "type": "de", "key": "  │ de", "keyColor": "#a746e8" },
    { "type": "terminal", "key": "  │ terminal", "keyColor": "#a746e8" },
    { "type": "packages", "key": "  ╰─ packages", "keyColor": "#a746e8" },
    { "type": "custom", "format": "\u001b[38;2;189;158;234m  ◇ research · build · understand · nous\u001b[0m" }
  ]
}

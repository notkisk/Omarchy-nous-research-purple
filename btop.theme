# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#090611"

# Main text color
theme[main_fg]="#ded7e8"

# Title color for boxes
theme[title]="#ded7e8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#9563da"

# Background color of selected item in processes box. #ded7e8 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1029 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1029"

# Foreground color of selected item in processes box. Use #ded7e8 so
# the row text stays readable on the lighter_bg highlight; the previous
# #9563da produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#ded7e8"

# Color of inactive/disabled text
theme[inactive_fg]="#342346"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e7def0 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #ded7e8 directly.
theme[graph_text]="#ded7e8"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #ded7e8 collapsed to the main fg.
theme[meter_bg]="#1a1029"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #bd9eea for a distinct accent instead of #e7def0 which capped to white.
theme[proc_misc]="#bd9eea"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a746e8"
theme[mem_box]="#a99acb"
theme[net_box]="#e06ba8"
theme[proc_box]="#9563da"

# Box divider line and small boxes line color
theme[div_line]="#342346"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#a99acb"
theme[temp_mid]="#d9c979"
theme[temp_end]="#e06ba8"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#bd9eea"
theme[cpu_mid]="#9563da"
theme[cpu_end]="#a746e8"

# Mem/Disk free meter
theme[free_start]="#a746e8"
theme[free_mid]="#9563da"
theme[free_end]="#bd9eea"

# Mem/Disk cached meter
theme[cached_start]="#9563da"
theme[cached_mid]="#bd9eea"
theme[cached_end]="#a746e8"

# Mem/Disk available meter
theme[available_start]="#d9c979"
theme[available_mid]="#e06ba8"
theme[available_end]="#e06ba8"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#a99acb"
theme[used_mid]="#bd9eea"
theme[used_end]="#9563da"

# Download graph colors
theme[download_start]="#d9c979"
theme[download_mid]="#e06ba8"
theme[download_end]="#e06ba8"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#a99acb"
theme[upload_mid]="#bd9eea"
theme[upload_end]="#9563da"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#bd9eea"
theme[process_mid]="#9563da"
theme[process_end]="#a746e8"
